      "source": [
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#Theme\n",
        "plt.style.use('dark_background')\n",
        "\n",
        "#Define Dataset from dic\n",
        "marks={\"marks\":[15,35,53,74,89]}\n",
        "var = pd.DataFrame(marks)\n",
        "\n",
        "#Figure size\n",
        "plt.figure(figsize=(10,5))\n",
        "\n",
        "#Plot color and style\n",
        "plt.plot(var['marks'], marker = \"s\", linestyle= \"--\", linewidth=\"0.8\", color= \"green\")\n",
        "\n",
        "#Labels\n",
        "plt.xlabel(\"Student\", fontsize = 12, color = \"orange\")\n",
        "plt.ylabel(\"Marks\", fontsize= 14, color = \"violet\")\n",
        "\n",
        "#Title\n",
        "plt.title(\"Student Marks\", fontsize = 16,color = \"purple\")\n",
        "\n",
        "#Limit on axis\n",
        "plt.xlim(0,5)\n",
        "plt.ylim(0,100)\n",
        "\n",
        "#Ticks limit\n",
        "plt.yticks(range(0,101,10))\n",
        "plt.xticks(range(0,6,1))\n",
        "\n",
        "#Grid\n",
        "plt.grid(True, linestyle= '--', linewidth= 0.4)\n",
        "\n",
        "#legend\n",
        "plt.legend()\n",
        "\n",
        "plt.show()"
      ],
